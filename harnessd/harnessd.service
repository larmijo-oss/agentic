[Unit]
Description=UM EECS Agentic harnessd
After=network.target
StartLimitIntervalSec=0

[Service]
Type=simple
Restart=on-failure
RestartSec=1
User=ubuntu
Group=www-data
WorkingDirectory=/home/ubuntu/agentic/harnessd

# Allow non-root user to bind to port 443 and read
SecureBits=keep-caps
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE

# API keys
EnvironmentFile=/home/ubuntu/.env.sys

# TypeScript
ExecStart=/usr/bin/node harnessd.js

[Install]
WantedBy=multi-user.target
