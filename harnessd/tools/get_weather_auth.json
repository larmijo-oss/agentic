                "ticket": {
                    "type": "string",
                    "description": "Authorization ticket obtained from get_auth tool"
                },
                "latitude": {
                    "type": "string",
                    "description": "latitude of location of interest"
                },
                "longitude": {
                    "type": "string",
                    "description": "longitude of location of interest"
                }
            },
            "required": [
